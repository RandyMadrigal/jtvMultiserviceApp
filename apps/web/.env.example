# All VITE_ vars are embedded in the JS bundle at build time — do NOT put secrets here.

# WhatsApp business number (digits only, with country code)
VITE_WHATSAPP_NUMBER=

# Backend API base URL
VITE_API_URL=

# Public URL of the site, without trailing slash (canonical and og:url). Optional:
# defaults to https://jtvmultiservice.com. index.html, public/robots.txt and
# public/sitemap.xml are static and must be updated by hand if the domain changes.
VITE_SITE_URL=
