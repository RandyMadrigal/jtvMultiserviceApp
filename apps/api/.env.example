# Copy to .env and fill in real values before running
PORT=xxxx
NODE_ENV=development/production

# SECURITY — generate a strong random string (min 32 chars)
# Run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=JWT_SECRET_HERE
JWT_EXPIRES_IN=15m

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=CORS_ORIGINS_HERE

# DATABASE — MongoDB connection string
# Local:   mongodb://
# Atlas:   mongodb+srv:
MONGODB_URI=MONGODB_URI_HERE

CLOUDINARY_CLOUD_NAME=CLOUDINARY_CLOUD_NAME_HERE
CLOUDINARY_API_KEY=CLOUDINARY_API_KEY_HERE
CLOUDINARY_API_SECRET=CLOUDINARY_API_SECRET_HERE

#seed Admin User
ADMIN_EMAIL=ADMIN_EMAIL_HERE
ADMIN_PASSWORD=ADMIN_PASSWORD_HERE

# Resend — email transaccional (OTP verificación)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=noreply@xxxxxxxxxxxx.com
