# Copy to .env and fill in real values before running
PORT=
NODE_ENV=

# SECURITY — genera una cadena aleatoria fuerte (mín. 32 chars)
# Run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=

# CORS — lista separada por comas de los orígenes permitidos del frontend
CORS_ORIGINS=

# URL pública del frontend — usada para construir enlaces en emails (reset de contraseña)
# En producción: https://tudominio.com
APP_URL=

# DATABASE — MongoDB connection string
# Local:   mongodb://localhost:27017/jtv
# Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/jtv
MONGODB_URI=

# Cloudinary — almacenamiento de imágenes de productos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Admin por defecto — se crea en el primer arranque si no existe
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Resend — email transaccional (OTP verificación, reset de contraseña)
RESEND_API_KEY=
RESEND_FROM=

# Health check — si se define, el endpoint GET /health requiere el header X-Health-Token
# Ejemplo: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# HEALTH_TOKEN=
